# ============================================
# Aiprep365 – AI ADMISSIONS AGENT
# ============================================

# --- AI Voice Platform (pick one) ---
# Vapi (recommended) → https://vapi.ai
VAPI_API_KEY=your_vapi_api_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_ASSISTANT_ID=your_vapi_assistant_id          # created by setup script

# Retell (alternative) → https://retellai.com
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_retell_agent_id
RETELL_PHONE_NUMBER=+1xxxxxxxxxx

# Which platform to use: "vapi" | "retell"
VOICE_PLATFORM=vapi

# --- AI Brain ---
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
# Which LLM to use inside Vapi: "openai" | "anthropic"
LLM_PROVIDER=openai

# --- Google Sheets ---
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your_google_sheet_id

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=primary

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admissions@Aiprep365.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=Sarah – Aiprep365
EMAIL_FROM=admissions@Aiprep365.com

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Server ---
PORT=3000
NODE_ENV=production
BASE_URL=https://your-ngrok-or-domain.com      # must be publicly reachable for webhooks
JWT_SECRET=change_this_to_something_secret

# --- Company ---
COMPANY_NAME=Aiprep365
COUNSELOR_NAME=Sarah
COUNSELOR_EMAIL=sarah@Aiprep365.com
COUNSELOR_PHONE=+1xxxxxxxxxx
COMPANY_WEBSITE=https://Aiprep365.com

# --- Call Settings ---
CALL_MAX_ATTEMPTS=3
CALL_RETRY_DELAY_MINUTES=60
SHEETS_POLL_INTERVAL_SECONDS=30
